events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log;

    sendfile on;
    keepalive_timeout 65;

    server {
        listen 80;
        server_name _;

        location /api {
            proxy_pass https://labkeeper.io;
            proxy_set_header Host labkeeper.io;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_ssl_server_name on;
            proxy_ssl_verify off;

            proxy_cookie_domain labkeeper.io nginx;
            proxy_cookie_domain .labkeeper.io nginx;
            proxy_cookie_flags ~ nosecure samesite=lax;
        }

        location / {
            proxy_pass http://host.docker.internal:3000;
            proxy_set_header Host localhost:3000;
            proxy_set_header X-Real-IP 127.0.0.1;
            proxy_set_header X-Forwarded-For 127.0.0.1;
            proxy_set_header X-Forwarded-Proto http;
            proxy_set_header X-Forwarded-Host localhost:3000;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_set_header Accept-Encoding "";

            sub_filter 'IO_LABKEEPER_FRONTEND_YANDEX_CAPTCHA_SITE_KEY'
                       '${YANDEX_CAPTCHA_SITE_KEY}';
            sub_filter_once off;
            sub_filter_types text/html;
        }
    }
}
