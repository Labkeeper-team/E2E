E2E_HOST=https://labkeeper.io
E2E_CAPTCHA_BYPASS_TOKEN=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Optional scenarios that need a second independent user
E2E_SECOND_USER_EMAIL=
E2E_SECOND_USER_PASSWORD=

# Only projects with this reserved prefix may be removed by test cleanup
E2E_PROJECT_PREFIX=e2e-autotest

# Landing scenarios run against production only, and 0, false, off or no also keep them skipped
ENABLE_LANDING_TESTS=

# Optional: publish the run summary to an ntfy topic instead of the HTML report
E2E_NTFY_URL=
E2E_NTFY_USERNAME=
E2E_NTFY_PASSWORD=
